{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Mobile App (Web)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"web",
				"--",
				"--host",
				"127.0.0.1"
			],
			"options": {
				"cwd": "${workspaceFolder}\\mobile"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Start Website (Vite)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}